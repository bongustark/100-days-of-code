#include <stdio.h>

int main() {
    int n;
    long long sum; 

    printf("Enter a positive integer (n): ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Please enter a valid positive integer.\n");
        return 1;
    }

    sum = (long long)n * (n + 1) / 2;

    printf("The sum of the first %d natural numbers is: %lld\n", n, sum);

    return 0;
}
